# Swift / SwiftPM
.build/
.swiftpm/
Package.resolved

# Xcode
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
xcuserdata/
DerivedData/
*.xcuserstate
*.xcscmblueprint

# Tuist-generated Xcode projects (regenerate with `tuist generate`)
zetty.xcodeproj/
zetty.xcworkspace/
# Tuist-generated Info.plists + bundle accessors. Tracking these makes the tree
# permanently dirty after a version bump (generate rewrites them), which the
# "Stamp build commit" phase reads as a WIP build and shows a commit hash
# instead of the marketing version in the status bar.
Derived/

# macOS
.DS_Store

# Vendored libghostty build artifacts
vendor/**/zig-out/
vendor/**/zig-cache/
vendor/**/GhosttyKit.xcframework
vendor/**/.zig-cache/

# Release packaging
build/
dist/

# Local process artifacts (brainstorming specs + implementation plans)
docs/superpowers/

# Misc
*.log
